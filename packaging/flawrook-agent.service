[Unit]
Description=FlawRook agent: reports this server's OS packages and runtimes to FlawRook
Documentation=https://github.com/flawrook/agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/flawrook-agent
# The agent itself sends the running agent SIGHUP: no shell, which the system call filter of systemd 235 to 238
# stops, and no kill program, which a minimal Debian (no procps) lacks. It signals only $MAINPID, a flawrook-agent.
ExecReload=/usr/bin/flawrook-agent --reload $MAINPID
Restart=on-failure
RestartSec=60

# Go's soft heap limit, and the hard cap for the whole process.
Environment=GOMEMLIMIT=96MiB
MemoryMax=256M

# The scan yields to everything else: the lowest CPU priority, and IO best-effort at its lowest level.
# Not the idle IO class: on a disk that is never idle it would starve the scan forever. Best-effort 7
# always gets its turn, last. (IO priorities apply where the disk's scheduler honours them: BFQ, mq-deadline.)
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# A user of its own, with no capabilities: the package databases and the runtimes' binaries are
# world-readable. install.sh's FLAWROOK_READ_PROTECTED=1 adds CAP_DAC_READ_SEARCH in a drop-in, to read files
# no other user may (read_protected in agent.yaml).
DynamicUser=yes
CapabilityBoundingSet=
NoNewPrivileges=yes
# Its config, /etc/flawrook (agent.yaml, a CA file), is root's and the flawrook group's (0750 and 0640).
SupplementaryGroups=flawrook
# Before 232 systemd ignores DynamicUser=, and the agent would run as root. FLAWROOK_SERVICE, which every
# systemd passes on, tells the agent its unit started it: as root it refuses, with exit status 78 (EX_CONFIG),
# and the refusal isn't restarted.
Environment=FLAWROOK_SERVICE=1
RestartPreventExitStatus=78
# A home of its own: systemd 237 gives a DynamicUser= service no HOME, and Syft's home lookup then runs getent,
# a process the system call filter stops.
Environment=HOME=/var/lib/flawrook

# Read-only everywhere but /var/lib/flawrook, which keeps the generated host id when there's no machine id.
StateDirectory=flawrook
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# @system-service came with systemd 239. Before it (235 to 238, Ubuntu 18.04) systemd ignores the name and
# allows @default only, and the agent died of SIGSYS. The 235-era sets and calls after it are what the agent
# makes (strace, 0.2.0): inside @system-service on 239 and later, so there they change nothing.
SystemCallFilter=@system-service @basic-io @file-system @io-event @network-io @process @resources @signal getrandom ioctl madvise sched_getaffinity uname

# Outbound only: HTTPS over IPv4 or IPv6, Unix sockets for the resolver, and no port ever bound.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SocketBindDeny=any

[Install]
WantedBy=multi-user.target
